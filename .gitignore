# =============================================================================
# .gitignore - Co-piloto de Gobernanza Corporativa
# =============================================================================
# Define que archivos NO deben subirse al repositorio publico.
# Es critico aqui porque .env contiene credenciales reales de
# MongoDB Atlas, GitHub Models y LangSmith.
# =============================================================================

# --- Credenciales y secretos (NUNCA subir) ---
.env
.env.local
.env.*.local
*.pem
*.key

# --- Borradores y archivos privados ---
INFORME_BORRADOR.md

# --- Informes de evaluacion: se entregan por AVA/correo, NO via repositorio ---
INFORME_TECNICO_EP2.md
INFORME_EP3.md
*.docx

# --- Comprimidos / respaldos locales ---
*.rar
*.zip
*.7z

# --- Estado en runtime del agente (Fase 4) ---
# memoria_largo_plazo.json lo genera el agente al ejecutarse; es estado
# local de cada sesion, no codigo fuente, asi que no se versiona.
memoria_largo_plazo.json

# --- Entornos virtuales ---
venv/
env/
.venv/
ENV/

# --- Cache y bytecode de Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# --- Distribucion / build ---
build/
dist/
*.egg-info/
*.egg
.eggs/

# --- Test y cobertura ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# --- Logs y outputs locales ---
*.log
# EP3: se ignora el contenido de logs/ EXCEPTO las trazas del agente.
# agente_trazas.jsonl se versiona a proposito: es la evidencia reproducible
# de observabilidad que el evaluador necesita para validar el dashboard sin
# gastar cuota de API. (Un directorio ignorado con "logs/" impediria la
# excepcion; por eso se usa "logs/*" + negacion puntual.)
logs/*
!logs/agente_trazas.jsonl
*.out

# --- Editores e IDEs ---
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject

# --- Sistema operativo ---
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
.directory

# --- Jupyter (por si se usa para analisis exploratorio) ---
.ipynb_checkpoints/

# --- Trazabilidad local de LangChain (los traces reales viven en LangSmith cloud) ---
.langchain/
langchain.db
