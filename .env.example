# =============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO - Co-piloto de Gobernanza Corporativa
# =============================================================================
# Copia este archivo a ".env" y reemplaza los valores con tus credenciales.
# El archivo .env NUNCA debe subirse a GitHub (ya está en .gitignore).
# Esta plantilla SÍ se sube para que el profesor sepa qué variables necesita.
# =============================================================================

# --- GitHub Models (proveedor de LLM y embeddings) ---
# GitHub Models expone una API REST compatible con OpenAI a traves de Azure.
# Usamos un Personal Access Token (PAT) clasico de GitHub como bearer token.
# Ventaja: cuota gratuita generosa para uso academico y mismos modelos que OpenAI
# (text-embedding-3-small, gpt-4o-mini, etc.) sin cambiar la SDK de LangChain.
# Generar token en: https://github.com/settings/tokens (sin scopes especiales)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Endpoint del catalogo de modelos. Lo sobreescribimos al instanciar
# OpenAIEmbeddings y ChatOpenAI para redirigir las llamadas a Azure
# en lugar del endpoint por defecto de OpenAI.
GITHUB_BASE_URL=https://models.inference.ai.azure.com

# --- MongoDB Atlas ---
# Cadena de conexión al cluster de Atlas. Debe tener permisos de lectura/escritura
# sobre la base de datos. Formato:
# mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Nombre de la base de datos y colección donde se almacenarán los chunks vectorizados.
# Usamos nombres explícitos para que la rúbrica pueda verificarlos directamente en Atlas.
DB_NAME=copiloto_gobernanza
COLLECTION_NAME=documentos
INDEX_NAME=vector_index

# --- LangSmith (Observabilidad - Fase 2) ---
# Permite trazar cada paso del pipeline RAG (retrieval, prompts, tokens, latencia).
# Es la evidencia objetiva exigida por la rúbrica para evaluar el pipeline.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_pt_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGCHAIN_PROJECT=copiloto-gobernanza-cencosud
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com